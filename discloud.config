ID=projectnoximporter
TYPE=bot
MAIN=build/index.js
NAME=Project Nox Importer
RAM=512
AUTORESTART=true
VERSION=22
APT=tools,tesseract-ocr,tesseract-ocr-por,tesseract-ocr-eng
# The importer has a hard 24-request media fence plus a bounded metadata
# lane. Production telemetry attributed roughly 276 MiB of otherwise
# unaccounted RSS to the 32-thread native footprint while just ~45 MiB was
# live page memory. Network I/O is asynchronous; sixteen workers retain
# DNS/file headroom without consuming the reader's safety margin in this
# 512 MiB container.
START=env UV_THREADPOOL_SIZE=16 MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 MALLOC_MMAP_THRESHOLD_=1 node --expose-gc --max-old-space-size=288 build/index.js

