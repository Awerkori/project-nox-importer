ID=projectnoximporter
TYPE=bot
MAIN=build/index.js
NAME=Project Nox Importer
RAM=512
AUTORESTART=true
VERSION=22
APT=tools,tesseract-ocr,tesseract-ocr-por,tesseract-ocr-eng
# The importer has a hard 24-request media fence plus a bounded metadata
# lane. With no active pages, the 16-thread process still retained roughly
# 264 MiB of native RSS after a media wave. HTTP I/O is asynchronous; eight
# workers retain DNS/file headroom while returning enough margin to the
# bounded media path in this 512 MiB container.
START=env UV_THREADPOOL_SIZE=8 MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 MALLOC_MMAP_THRESHOLD_=1 node --expose-gc --max-old-space-size=288 build/index.js

