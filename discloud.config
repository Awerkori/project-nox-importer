ID=projectnoximporter
TYPE=bot
MAIN=build/index.js
NAME=Project Nox Importer
RAM=624
AUTORESTART=true
VERSION=22
APT=tools,tesseract-ocr,tesseract-ocr-por,tesseract-ocr-eng
# The importer has a hard 24-request media fence plus a bounded metadata
# lane. With no active pages, the 8-thread process still retained roughly
# 266 MiB of native RSS after a media wave while only 11 MiB was externally
# live. One allocator arena limits retained native fragmentation; the importer
# has bounded media work and does not need allocator parallelism in this
# 624 MiB container.
START=env DISCLOUD_RAM_MB=624 UV_THREADPOOL_SIZE=8 MALLOC_ARENA_MAX=1 MALLOC_TRIM_THRESHOLD_=131072 MALLOC_MMAP_THRESHOLD_=1 node --expose-gc --max-old-space-size=352 build/index.js

