# ==============================================================================
# PROJECT NOX IMPORTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Connection (Project Nox Manga DB)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Provider: 'telegram' (production) or 'mock' (local testing)
STORAGE_PROVIDER=telegram

# Telegram Storage Configuration (Required if STORAGE_PROVIDER=telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=-1001234567890

# Bot identity: user ID in public.members to attribute uploaded media
IMPORTER_USER_ID=

# Worker Instance Identification (for atomic queue lease/locking)
WORKER_ID=nox-importer-worker-1

# Engine Polling & Limits
POLL_INTERVAL_SECONDS=60
QUEUE_LEASE_DURATION_SECONDS=300
QUEUE_HEARTBEAT_INTERVAL_SECONDS=60
MAX_CONCURRENT_CHAPTERS=1
# Lite starts with one worker even if legacy MAX_CONCURRENT_CHAPTERS is high.
# Raise this only after the isolated YSQL/Telegram/site benchmark records a
# sustainable value; it is ignored while IMPORTER_RUNTIME_MODE=legacy.
LITE_CHAPTER_WORKERS=4
BATCH_PAGE_DOWNLOAD_CONCURRENCY=3
# Global Telegram payload budget. The Lite default is 8 MiB/s after a
# measured ramp; an explicit lower value remains an immediate rollback.
UPLOAD_RATE_LIMIT_BYTES_PER_SEC=8388608

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
