# ==============================================================================
# PROJECT NOX IMPORTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Connection (Project Nox Manga DB)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Provider: 'telegram' (production) or 'mock' (local testing)
STORAGE_PROVIDER=telegram

# Telegram Storage Configuration (Required if STORAGE_PROVIDER=telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=-1001234567890

# Bot identity: user ID in public.members to attribute uploaded media
IMPORTER_USER_ID=

# Worker Instance Identification (for atomic queue lease/locking)
WORKER_ID=nox-importer-worker-1

# Engine Polling & Limits
POLL_INTERVAL_SECONDS=60
QUEUE_LEASE_DURATION_SECONDS=300
QUEUE_HEARTBEAT_INTERVAL_SECONDS=60
MAX_CONCURRENT_CHAPTERS=1
BATCH_PAGE_DOWNLOAD_CONCURRENCY=3

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
